# =====================================================================
#  Environment variables — TEMPLATE ONLY
#
#  Copy to `.env` for local development and fill in your own values.
#  `.env` and every `.env.*` variant are git-ignored; this file is the
#  only one that is tracked.
#
#  NEVER commit real secrets, API keys, project URLs or any
#  production-specific value to this file. Every value below is a
#  deliberately non-functional placeholder.
#
#  ---------------------------------------------------------------------
#  THE `VITE_` PREFIX IS A SECURITY BOUNDARY
#
#  Vite compiles every `VITE_`-prefixed variable into the JavaScript
#  bundle that ships to the browser. Anything with that prefix is
#  PUBLIC — treat it as if it were printed on the home page.
#
#  Anything WITHOUT the prefix is read only by server-side code
#  (Vercel Functions, Supabase Edge Functions) and never reaches the
#  client.
#
#  Never give a secret a `VITE_` prefix. Never assume an unprefixed
#  variable is available in the browser — it is not.
#  ---------------------------------------------------------------------
#
#  Scope legend:
#    Production  — Vercel -> Settings -> Environment Variables -> Production
#    Preview     — the Preview environment (staging / PR deployments)
#    Local       — your local `.env`
# =====================================================================


# =====================================================================
#  1. SERVER-ONLY — never exposed to the browser
#     No `VITE_` prefix. Read via `process.env` / `Deno.env.get`.
# =====================================================================

# Supabase service-role key. Bypasses ALL Row Level Security.
# Used by: api/generate-pack-audio.ts, api/send-daily-reminders.ts,
#          supabase/functions/generate-pack-audio/index.ts
# The most dangerous value in this file. Never expose it to a client,
# never put it in a VITE_ variable, never reuse it across projects.
# Scope: Production, Preview, Local
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase anon (publishable) key — SERVER-SIDE copy.
# Used by: api/generate-pack-audio.ts — builds a Supabase client carrying
#          the CALLER's JWT so is_admin() can be evaluated as that user
#          (A1-3a authorization).
# This is a DIFFERENT VARIABLE from VITE_SUPABASE_ANON_KEY in section 2,
# even though the value is normally the same key. They are kept separate
# on purpose: the name alone tells you whether a value is bundled into
# client JS. Do not merge them and do not add a fallback between them.
# Scope: Production, Preview, Local
SUPABASE_ANON_KEY=your-anon-key-here

# Google Cloud Text-to-Speech API key.
# Used by: api/generate-pack-audio.ts, supabase/functions/generate-pack-audio/
# Generates pronunciation audio for vocabulary packs (admin-only feature).
# Recommended: restrict this key to the Text-to-Speech API and set a
# QUOTA CAP on the GCP project — a cap prevents runaway cost, a budget
# alert only reports it.
# Scope: Production, Preview, Local (only if testing TTS locally)
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# Shared secret authenticating the Vercel Cron scheduler.
# Used by: api/send-daily-reminders.ts (daily flashcard-review reminder).
# Vercel automatically attaches `Authorization: Bearer $CRON_SECRET` to
# scheduled invocations once this variable exists on the project.
#
# PRODUCTION SECRET. Generate a fresh high-entropy value:
#     openssl rand -hex 32
#
# DO NOT reuse a Supabase key, a Google API key, or any other existing
# credential. This must be its own standalone value.
# Use a DIFFERENT value on Preview than on Production.
# Scope: Production (required), Preview (optional), Local (optional)
CRON_SECRET=generate-with-openssl-rand-hex-32

# Web Push (VAPID) key pair and contact address.
# Used by: api/send-daily-reminders.ts to sign push notifications.
# VAPID_PUBLIC_KEY must match VITE_VAPID_PUBLIC_KEY in section 2 — the
# browser subscribes with the public half, the server signs with the
# private half.
# VAPID_PRIVATE_KEY is a secret. Only the public half may be exposed.
# Scope: Production, Preview, Local (only if testing push locally)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=mailto:you@example.com

# Supabase project URL — server-side fallback.
# Used by: api/generate-pack-audio.ts, api/send-daily-reminders.ts,
#          supabase/functions/generate-pack-audio/index.ts
# The Vercel handlers read VITE_SUPABASE_URL first and fall back to this.
# Setting VITE_SUPABASE_URL (section 2) alone is sufficient on Vercel;
# this exists mainly for Supabase Edge Functions, where the platform
# injects SUPABASE_URL automatically.
# Scope: Production, Preview, Local (optional — usually unnecessary)
# SUPABASE_URL=https://your-project-id.supabase.co


# =====================================================================
#  2. CLIENT-EXPOSED (Vite) — COMPILED INTO THE BROWSER BUNDLE
#     Everything here is PUBLIC. Never place a secret in this section.
# =====================================================================

# Supabase project URL.
# Used by: src/lib/supabase.ts (browser client), and as the server-side
#          first choice in api/*.ts.
# Public by design — visible in every network request anyway.
# Scope: Production, Preview, Local
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon (publishable) key — BROWSER copy.
# Used by: src/lib/supabase.ts
# Public by design. Safe only because Row Level Security is what actually
# protects the data — see docs/PRODUCTION_SCHEMA_AUDIT.md.
# Distinct from SUPABASE_ANON_KEY in section 1: same value, different
# name, different consumer. The naming is the point — VITE_ means bundled.
# Scope: Production, Preview, Local
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Which product this deployment serves: GSAT | TOEIC | KIDS
# Used by: src/config/product.ts — selects branding, navigation, feature
#          flags and vocabulary levels.
# Default when unset: GSAT
# Scope: Production, Preview, Local
VITE_APP_PRODUCT=GSAT

# Web Push public key (browser half of the VAPID pair in section 1).
# Used by: src/hooks/usePushSubscription.ts
# Must match VAPID_PUBLIC_KEY. Public by design.
# Scope: Production, Preview, Local (only if testing push locally)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Site override for local development: gsat | toeic | kids
# Used by: src/hooks/useSiteIdentifier.ts
# In deployed environments the site is derived from the hostname, so this
# is normally unset. It only matters on localhost, where the hostname
# carries no site information.
# Default when unset (and hostname unrecognised): toeic
# Scope: Local mainly. Rarely needed on Preview; never on Production.
# VITE_SITE_ID=gsat

# Enables the in-app developer tools panel (phase switcher).
# Used by: src/components/dev/DevPhaseSwitcher.tsx
# When 'true', ?devmode=true can open the panel on a deployed build.
#
# LOCAL AND PREVIEW ONLY. NEVER enable in Production.
#
# Local development already enables the panel via import.meta.env.DEV, so
# this variable exists purely to keep the capability on Preview. In
# Production it must remain UNSET — with it unset there is no activation
# path at all.
# Scope: Preview only (Local works without it)
# VITE_ENABLE_DEV_TOOLS=true


# =====================================================================
#  3. OPTIONAL CONFIGURATION — sensible defaults, set only to override
# =====================================================================

# Maximum pack_items processed per TTS generation request (server-only).
# Used by: api/generate-pack-audio.ts
# A TIMEOUT bound, not a security limit: the function has maxDuration 60s
# and each item costs up to two syntheses, so large packs are processed
# in chunks and the admin UI loops until finished.
#
#   Default: 100   <- leave unset to use this
#   The largest production pack (214 items) completes in 3 chunks.
#
# On staging, a small value such as 2 makes a tiny fixture pack exercise
# the chunking loop.
# Do not raise it beyond what a real pack completes in well under 45s.
# Scope: optional everywhere
# TTS_MAX_ITEMS_PER_REQUEST=100


# =====================================================================
#  QUICK REFERENCE
#
#  Variable                      Type            Required    Scope
#  ---------------------------------------------------------------------
#  SUPABASE_SERVICE_ROLE_KEY     server secret   yes         Prod/Prev/Local
#  SUPABASE_ANON_KEY             server          yes         Prod/Prev/Local
#  GOOGLE_TTS_API_KEY            server secret   TTS only    Prod/Prev/Local
#  CRON_SECRET                   server secret   yes (Prod)  Prod (Prev opt)
#  VAPID_PUBLIC_KEY              server          push only   Prod/Prev/Local
#  VAPID_PRIVATE_KEY             server secret   push only   Prod/Prev/Local
#  VAPID_EMAIL                   server          push only   Prod/Prev/Local
#  SUPABASE_URL                  server          optional    Prod/Prev/Local
#  VITE_SUPABASE_URL             client public   yes         Prod/Prev/Local
#  VITE_SUPABASE_ANON_KEY        client public   yes         Prod/Prev/Local
#  VITE_APP_PRODUCT              client public   optional    Prod/Prev/Local
#  VITE_VAPID_PUBLIC_KEY         client public   push only   Prod/Prev/Local
#  VITE_SITE_ID                  client public   optional    Local mainly
#  VITE_ENABLE_DEV_TOOLS         client public   optional    PREVIEW ONLY
#  TTS_MAX_ITEMS_PER_REQUEST     server          optional    any
#
#  `DEV` and `PROD` are Vite built-ins — do not set them.
# =====================================================================
